# 서버의 .env 로 복사해 실제 값으로 채운다(권한 600). .env 는 커밋하지 않는다.
SPRING_DATASOURCE_URL=jdbc:postgresql://fake-host.ap-northeast-2.rds.amazonaws.com:5432/devpay
DB_PASSWORD=fake-long-random-value
SPRING_JPA_SHOW_SQL=false
# JWT 서명 키(32바이트 이상). 없으면 서버가 시작되지 않는다. 예: openssl rand -base64 48
JWT_SECRET=fake-long-random-value-at-least-32-bytes
# 네이버 지도(선택). 가맹점 주소를 좌표로 바꿀 때 쓴다. 비어 있으면 변환 없이 위치 없이 저장한다. 값을 채우려면 주석(#)을 지운다.
# NAVER_MAP_CLIENT_ID=
# NAVER_MAP_CLIENT_SECRET=
# 최초 운영자 계정(선택). 다섯 값이 모두 있을 때만 서버가 시작할 때 한 번 만든다. 같은 이메일·전화번호가 있으면 건드리지 않는다.
# 값을 채우려면 주석(#)을 지운다. 회원가입과 같은 규칙이다: 비밀번호 8~15자(영문·숫자·!@#%^&* 포함), 전화번호 하이픈 없이 숫자만, PIN 숫자 6자리.
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# ADMIN_NAME=
# ADMIN_PHONE=
# ADMIN_PIN=
